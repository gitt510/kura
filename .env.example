# Scheduled generation agent: claude (default) or codex.
# Each KURA_<AGENT>_* pair applies only while that agent is selected;
# unset values inject no flag and leave the CLI's own default in charge.
KURA_GENERATOR=claude
KURA_CLAUDE_MODEL=
KURA_CLAUDE_EFFORT=
KURA_CODEX_MODEL=
KURA_CODEX_EFFORT=

# Optional Discord consumers.
# Run `just init-env`, then edit the generated config file.
KURA_DISCORD_WEBHOOK_ENGLISH=
KURA_DISCORD_WEBHOOK_TIMELINE=
KURA_DISCORD_AVATAR_CLAUDE=
KURA_DISCORD_AVATAR_GPT=
