# Optional 1Password references.
# Copy this file to .env.ref, replace the example paths, then run `just bake-env`.
#
# `just bake-env` overwrites the whole config file, so declare non-secret
# settings here too — `op inject` passes lines without op:// through verbatim.
KURA_GENERATOR=claude
KURA_CLAUDE_MODEL=
KURA_CLAUDE_EFFORT=
KURA_CODEX_MODEL=
KURA_CODEX_EFFORT=

KURA_DISCORD_WEBHOOK_ENGLISH=op://your-vault/discord-webhook/english
KURA_DISCORD_WEBHOOK_TIMELINE=op://your-vault/discord-webhook/timeline

# Optional model-family avatar for Discord feeds. The family prefix is the first
# segment of the model name, uppercased (claude-opus-5 -> CLAUDE). Any publicly
# fetchable image URL works. Unset families keep the webhook's own avatar, which
# is where a single fixed icon belongs — set that in Discord, not here.
KURA_DISCORD_AVATAR_CLAUDE=
KURA_DISCORD_AVATAR_GPT=
